# Copy to .env (optional for local use).

# Port of the Streamable HTTP server (npm start). Azure App Service sets PORT automatically.
PORT=3001

# If set, every POST /mcp request must send "Authorization: Bearer <MCP_API_KEY>".
# Leave empty for local development.
MCP_API_KEY=

# Only used by `npm run demo`: talk to a deployed server instead of starting a local stdio process.
# MCP_URL=https://<your-mcp-app>.azurewebsites.net/mcp
