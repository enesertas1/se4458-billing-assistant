# Copy this file to .env and fill in the values. Never commit .env.

# Azure Database for PostgreSQL - Flexible Server connection string, e.g.
# postgresql://<admin-user>:<password>@<server-name>.postgres.database.azure.com:5432/billing
DATABASE_URL=
# Azure requires TLS
DB_SSL=true

# Any long random string. The API Gateway must use the SAME secret to validate tokens.
JWT_SECRET=change-me-to-a-long-random-string

PORT=3000
