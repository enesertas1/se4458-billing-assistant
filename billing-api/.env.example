# Copy this file to .env and fill in the values. Never commit .env.

# PostgreSQL connection string, e.g.
#   Azure:  postgresql://<admin-user>:<password>@<server-name>.postgres.database.azure.com:5432/billing
#   local:  postgresql://postgres:<password>@localhost:5432/billing
DATABASE_URL=
# true for Azure / cloud PostgreSQL (TLS required), false for a local server
DB_SSL=true

# Any long random string. The API Gateway must use the SAME secret to validate tokens.
JWT_SECRET=change-me-to-a-long-random-string

PORT=3000
