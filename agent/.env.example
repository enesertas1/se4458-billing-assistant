# Copy to .env and fill in. Never commit .env.

# Google AI Studio key (https://aistudio.google.com -> Get API key)
GEMINI_API_KEY=
# Free-tier Gemini model with function calling
GEMINI_MODEL=gemini-3.1-flash-lite

# Base URL for ALL REST calls = the API Gateway URL in the deployed system.
# Until the gateway exists you can point it to the local Billing API:
BILLING_API_URL=http://localhost:3000
# Azure API Management subscription key (only if the gateway requires one)
GATEWAY_SUBSCRIPTION_KEY=

# MCP server: leave MCP_URL empty to start the local stdio server (../mcp-server/src/stdio.js),
# or set the deployed Streamable HTTP endpoint:
MCP_URL=
# MCP_URL=https://<mcp-app>.azurewebsites.net/mcp
MCP_API_KEY=

# Optional: skip the login prompt (handy for recording the demo)
# AGENT_USERNAME=ayse
# AGENT_PASSWORD=Ayse123!
